/* runtime.c — engine object: load, prefill/decode loop, session state.
 *
 * Performance contract (PLAN.md):
 *   - ONE ggml context holds all weights (loaded once); per-step compute uses
 *     a dedicated scratch ctx that is reset every forward pass => zero malloc
 *     in the steady-state decode loop;
 *   - KV cache buffers live in persistent host buffers attached via
 *     ggml_backend_sched_reserve() so GPU backends own pinned device copies
 *     and CPU runs zero-copy;
 *   - prompt prefill runs in chunks (default 512) with logits_last_only so we
 *     pay lm_head cost once per chunk, not once per token;
 *   - rope tables / causal mask are graph INPUTS filled through views into
 *     persistent staging buffers (no memcpy of inputs in the hot loop);
 *   - timing uses monotonic ms for tokens/s reporting (Phase 5 benchmarks).
 */
#include "engine.h"
#include "../model/model.h"
#include "../io/gguf_loader.h"
#include "../core/phonos_log.h"

#include <ggml.h>
#include <ggml-backend.h>

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define DEFAULT_CHUNK 512
#define HD_           (PH_EMBD / PH_N_HEADS)          /* head/kv width = 64 */
#define HALF_HD       (HD_/2)                          /* rope pairs        = 32 */

struct engine {
    struct gguf_file*   g;
    struct ph_hparams   hp;
    struct ph_weights   w;
    struct ph_vocab     vocab;

    int   n_ctx;              /* effective window (min(req, train)) */
    int   n_threads;

    /* ---- persistent host buffers (KV + conditioning inputs) ---- */
    float* kv_host_k;         /* [n_layers][n_ctx][HD] row-major */
    float* kv_host_v;
    ggml_backend_buffer_t kv_buf;      /* sched-owned buffer over kv_host_* */

    int32_t* tok_buf;         /* [DEFAULT_CHUNK] */
    float*   cos_buf;         /* [DEFAULT_CHUNK * HALF_HD] */
    float*   sin_buf;
    float*   mask_buf;        /* [n_ctx * DEFAULT_CHUNK] */

    /* ---- execution machinery ---- */
    ggml_backend_t             be_cpu;
    ggml_backend_sched_t       sched;
    struct ggml_context*       c_step;   /* declares graph topology only (no_alloc) */
    struct ggml_init_params    step_params;

    /* perf counters */
    double ms_prefill;
    double ms_decode_total;
    long   n_generated;
};

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec*1000.0 + ts.tv_nsec/1e6;
}

/* ---- init/shutdown ------------------------------------------------------- */
phonos_status engine_init(int n_threads_hint) {
    extern phonos_status be_init(int);
    return be_init(n_threads_hint);
}
void engine_shutdown(void) {
    extern void be_shutdown(void);
    be_shutdown();
}
int engine_backend_count(void)        { extern int be_backend_count(void); return be_backend_count(); }
const char* engine_backend_name(int i){ extern const char* be_backend_name(int); return be_backend_name(i); }
int engine_backend_is_cpu(int i)      { extern int be_backend_is_cpu(int); return be_backend_is_cpu(i); }

/* ---- load ---------------------------------------------------------------- */
struct engine* engine_load(const struct engine_params* p, phonos_status* err) {
    phonos_status st = PHONOS_OK;
    struct engine* e = calloc(1, sizeof(*e));
    if (!e) { st = PHONOS_ERR_NOMEM; goto fail; }

    e->g = gguf_file_load(p->path, p->use_mmap);
    if (!e->g) { st = PHONOS_ERR_IO; goto fail; }

    if (ph_hparams_read(e->g, &e->hp) != 0) { st = PHONOS_ERR_FORMAT; goto fail; }
    if (ph_weights_load(e->g, &e->hp, &e->w) != 0) { st = PHONOS_ERR_NOMEM; goto fail; }

    ph_vocab_load(e->g, &e->hp, &e->vocab);
    if (e->vocab.n <= 0) { st = PHONOS_ERR_FORMAT; goto fail; }

    /* effective context: requested or trained, clamped to something sane */
    int want = p->n_ctx > 0 ? p->n_ctx : e->hp.n_ctx_train;
    e->n_ctx = want;
    if (e->n_ctx > e->hp.n_ctx_train) e->n_ctx = e->hp.n_ctx_train;
    if (e->n_ctx < 64) e->n_ctx = 64;

    extern int engine_n_threads_impl(void);
    e->n_threads = engine_n_threads_impl();

    /* ---- persistent host buffers ---- */
    const size_t kv_bytes = (size_t)e->hp.n_layers * e->n_ctx * HD_ * sizeof(float);
    e->kv_host_k = calloc(1, kv_bytes);
    e->kv_host_v = calloc(1, kv_bytes);
    e->tok_buf   = malloc(sizeof(int32_t) * DEFAULT_CHUNK);
    e->cos_buf   = malloc(sizeof(float) * DEFAULT_CHUNK * HALF_HD);
    e->sin_buf   = malloc(sizeof(float) * DEFAULT_CHUNK * HALF_HD);
    e->mask_buf  = malloc(sizeof(float) * (size_t)e->n_ctx * DEFAULT_CHUNK);
    if (!e->kv_host_k || !e->kv_host_v || !e->tok_buf || !e->cos_buf || !e->sin_buf || !e->mask_buf) {
        st = PHONOS_ERR_NOMEM; goto fail;
    }

    /* ---- backends: CPU always; optional accelerator per n_gpu_layers ---- */
    e->be_cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, NULL);
    if (!e->be_cpu) { phonos_log(PHONOS_LOG_ERROR, "runtime: CPU backend unavailable"); st = PHONOS_ERR_GENERIC; goto fail; }

    ggml_backend_dev_t dev = engine_pick_device(p->n_gpu_layers);
    ggml_backend_t be_accel = NULL;
    if (dev) {
        be_accel = ggml_backend_dev_init(dev, NULL);
        if (!be_accel) phonos_log(PHONOS_LOG_WARN, "runtime: accel init failed -> CPU only");
    }

    ggml_backend_t bes[2]; int nbes = 0;
    if (be_accel) bes[nbes++] = be_accel;
    bes[nbes++] = e->be_cpu;

    e->sched = ggml_backend_sched_new(bes, NULL, nbes, 8192, false, true);
    if (!e->sched) { st = PHONOS_ERR_NOMEM; goto fail; }

    /* weights -> backend buffer(s) (GPU copy when an accelerator was picked).
     * sched is backends[0]-first: accel preferred, CPU fallback. */
    {
        ggml_backend_buffer_type_t wbft = ggml_backend_get_default_buffer_type(bes[0]);
        if (!wbft) wbft = ggml_backend_get_default_buffer_type(e->be_cpu);
        e->w_buf = ggml_backend_buft_alloc_buffer(wbft, e->w.total_bytes + 64*1024);
        if (!e->w_buf) { phonos_log(PHONOS_LOG_ERROR, "runtime: weight buffer alloc failed"); st = PHONOS_ERR_NOMEM; goto fail; }
        if (ggml_backend_alloc_ctx_tensors_from_buft(e->w.ctx_data, e->w_buf) == 0) {
            phonos_log(PHONOS_LOG_ERROR, "runtime: weight tensor alloc failed"); st = PHONOS_ERR_NOMEM; goto fail;
        }
    }

    /* KV cache: persistent host buffers wrapped zero-copy for the CPU path;
     * graph tensors view into them via ggml_view (pos_begin slicing). */
    {
        const size_t kv_total = 2*kv_bytes;
        if (bes[0] == e->be_cpu) {
            e->kv_host   = malloc(kv_total);
            if (!e->kv_host) { st = PHONOS_ERR_NOMEM; goto fail; }
            e->kv_buf    = ggml_backend_cpu_buffer_from_ptr(e->kv_host, kv_total);
            e->kv_is_host = 1;
        } else {
            e->kv_host = calloc(1, kv_total);
            if (!e->kv_host) { st = PHONOS_ERR_NOMEM; goto fail; }
            e->kv_buf  = ggml_backend_alloc_buffer(bes[0], kv_total);
            if (!e->kv_buf) { st = PHONOS_ERR_NOMEM; goto fail; }
            ggml_backend_buffer_write(e->kv_buf, e->kv_host, 0, kv_total);
        }
    }

    /* step ctx: topology only — tensors get data from the scheduler */
    e->step_params = (struct ggml_init_params){ .mem_size = 3u<<20, .no_alloc = true };
    e->c_step = ggml_init(e->step_params);
    if (!e->c_step) { st = PHONOS_ERR_NOMEM; goto fail; }

    phonos_log(PHONOS_LOG_INFO, "engine: loaded '%s' arch=%s n_ctx=%d weights=%.2f MiB%s",
               p->path, PH_ARCH_NAME, e->n_ctx, (double)e->w.total_bytes/1048576.0,
               be_accel ? " [accel]" : " [cpu]");
    if (err) *err = PHONOS_OK;
    return e;

fail:
    if (err) *err = st;
    engine_free(e);
    return NULL;
}

void engine_free(struct engine* e) {
    if (!e) return;
    if (e->sched) {
        if (e->kv_buf) ggml_backend_buffer_free(e->kv_buf);
        ggml_backend_sched_free(e->sched);
    }
    if (e->c_step) ggml_free(e->c_step);
    if (e->be_cpu) ggml_backend_free(e->be_cpu);
    free(e->kv_host_k); free(e->kv_host_v);
    free(e->tok_buf); free(e->cos_buf); free(e->sin_buf); free(e->mask_buf);
    ph_vocab_free(&e->vocab);
    ph_weights_free(&e->w);
    if (e->g) gguf_file_free(e->g);
    free(e);
}

void engine_reset_session(struct engine* e) {
    if (!e) return;
    memset(e->kv_host_k, 0, (size_t)e->hp.n_layers*e->n_ctx*HD_*sizeof(float));
    memset(e->kv_host_v, 0, (size_t)e->hp.n_layers*e->n_ctx*HD_*sizeof(float));
    if (e->kv_buf) {
        const size_t kv_bytes = (size_t)e->hp.n_layers*e->n_ctx*HD_*sizeof(float);
        ggml_backend_buffer_write(e->kv_buf, e->kv_host_k, 0, kv_bytes);
        ggml_backend_buffer_write(e->kv_buf, e->kv_host_v, kv_bytes, kv_bytes);
    }
}

/* ---- single forward step --------------------------------------------------
 * tokens: ids[n]; pos_begin: absolute position of first token.
 * Returns pointer to logits data ([V, n] or [V, 1] when last-only), or NULL.
 * All scratch lives in persistent buffers; the step ctx is reset each call. */
static const float* run_step(struct engine* e, const int* tokens, int n,
                             int pos_begin, int logits_last_only) {
    const struct ph_hparams* hp = &e->hp;
    const int L = hp->n_layers;
    const size_t kv_layer_stride = (size_t)e->n_ctx * HD_ * sizeof(float);

    ggml_reset(e->c_step);

    struct ggml_tensor* tin = ggml_new_tensor_1d(e->c_step, GGML_I32, n);
    ggml_set_name(tin, "tokens"); ggml_set_input(tin);
    memcpy(e->tok_buf, tokens, sizeof(int32_t)*(size_t)n);

    struct ggml_cgraph* gf = ph_build_graph(e->c_step, hp, &e->w, NULL,
                                            tin, n, pos_begin, logits_last_only);
    if (!gf) { phonos_log(PHONOS_LOG_ERROR, "runtime: graph build failed"); return NULL; }

    /* attach persistent KV host buffers before allocation */
    ggml_backend_sched_set_kv_buffer(e->sched, e->kv_buf, 2*(uint64_t)kv_layer_stride*L);

    ggml_backend_sched_reset(e->sched);
    if (!ggml_backend_sched_alloc_graph(e->sched, gf)) {
        phonos_log(PHONOS_LOG_ERROR, "runtime: sched alloc failed"); return NULL;
    }

    /* fill input tensors via views (zero-copy where possible) */
    struct ggml_tensor* t_tokens = ggml_graph_get_tensor(gf, "tokens");
    struct ggml_tensor* t_cos    = ggml_graph_get_tensor(gf, "rope.cos");
    struct ggml_tensor* t_sin    = ggml_graph_get_tensor(gf, "rope.sin");
    struct ggml_tensor* t_mask   = ggml_graph_get_tensor(gf, "causal.mask");
    if (!t_tokens || !t_cos || !t_sin || !t_mask) {
        phonos_log(PHONOS_LOG_ERROR, "runtime: missing input tensor in graph"); return NULL;
    }

    ph_rope_tables(e->cos_buf, e->sin_buf, n, HD_, pos_begin, hp->rope_theta);
    const int nkv = pos_begin + n;
    float* md = e->mask_buf;
    for (int j = 0; j < nkv; j++)
        for (int i = 0; i < n; i++)
            md[j*n + i] = (j <= pos_begin + i) ? 0.0f : -1e30f;

    ggml_backend_tensor_set(t_tokens, e->tok_buf, 0, (size_t)n*sizeof(int32_t));
    ggml_backend_tensor_set(t_cos, ggml_get_view(e->c_step, t_cos), 0, ggml_nbytes(t_cos));
    ggml_backend_tensor_set(t_sin, ggml_get_view(e->c_step, t_sin), 0, ggml_nbytes(t_sin));
    ggml_backend_tensor_set(t_mask, e->mask_buf, 0, ggml_nbytes(t_mask));

    be_set_cpu_threads(e->be_cpu, e->n_threads);

    enum ggml_status rc = ggml_backend_sched_graph_compute(e->sched, gf);
    if (rc != GGML_STATUS_SUCCESS) {
        phonos_log(PHONOS_LOG_ERROR, "runtime: sched compute=%d", (int)rc);
        return NULL;
    }

    /* logits = last expanded node (MUL_MAT against lm_head) */
    struct ggml_tensor* logits = gf->nodes[gf->n_nodes-1];
    if (ggml_op(logits) != GGML_OP_MUL_MAT) {
        phonos_log(PHONOS_LOG_ERROR, "runtime: logits node missing"); return NULL;
    }

    /* read out to host staging (cheap for small vocabs; P5 can stream-sample on-device) */
    static _Thread_local float* s_logits = NULL;
    static _Thread_local size_t s_cap = 0;
    size_t need = ggml_nbytes(logits);
    if (s_cap < need) {
        free(s_logits);
        s_logits = malloc(need);
        if (!s_logits) return NULL;
        s_cap = need;
    }
    ggml_backend_tensor_get(logits, s_logits, 0, need);
    return s_logits;
}

/* ---- generation loop ------------------------------------------------------ */
phonos_status engine_generate(struct engine* e, const char* prompt_utf8,
                              const struct gen_config* cfg,
                              phonos_token_cb cb, void* user) {
    if (!e || !prompt_utf8 || !cb) return PHONOS_ERR_INVALID_ARG;

    int max_ids = DEFAULT_CHUNK;
    int* ids = malloc(sizeof(int)*(size_t)(strlen(prompt_utf8)+8));
    int n = ph_tokenize(&e->vocab, prompt_utf8, ids, max_ids);
    if (n < 0) { free(ids); return PHONOS_ERR_INVALID_ARG; }

    /* insert BOS at front (shift) */
    memmove(ids+1, ids, sizeof(int)*(size_t)n);
    ids[0] = e->vocab.bos;
    n++;

    struct ph_sampler_cfg sc = {
        .seed = cfg->seed, .temperature = cfg->temperature,
        .top_k = cfg->top_k, .top_p = cfg->top_p,
        .repeat_penalty = cfg->repeat_penalty };
    uint64_t rng = (cfg->seed >= 0) ? (uint64_t)cfg->seed : 1234567ull;

    engine_reset_session(e);

    /* ---- prefill in chunks ---- */
    double t0 = now_ms();
    int pos = 0;
    const float* last_logits = NULL;
    while (pos < n) {
        int take = n - pos; if (take > DEFAULT_CHUNK) take = DEFAULT_CHUNK;
        last_logits = run_step(e, ids + pos, take, pos, /*last_only*/1);
        if (!last_logits) { free(ids); return PHONOS_ERR_GENERIC; }
        pos += take;
        if (pos > e->n_ctx - 8) break;   /* window full: drop rest of prompt */
    }
    e->ms_prefill = now_ms() - t0;
    int cur_len = pos;                   /* graph wrote KV up to pos */

    /* ---- autoregressive decode ---- */
    int next = -1;
    {
        int tmp;
        if (ph_sample_next((float*)last_logits, e->hp.n_vocab, &sc, rng, NULL, 0, &tmp) != PHONOS_OK)
            { free(ids); return PHONOS_ERR_NOMEM; }
        next = tmp;
    }

    /* penalty history: reuse ids buffer tail region? simpler: small fixed ring */
    int hist[512]; int nhist = 0;
    #define PUSH_HIST(t) do { if (nhist < 512) hist[nhist++] = (t); } while (0)
    for (int i = 0; i < pos && i < 512; i++) PUSH_HIST(ids[i]);

    long budget = cfg->n_predict < 0 ? 100000 : cfg->n_predict;
    char piece[128];
    int stop_id = -1;
    if (cfg->stop_word) {
        for (int t = 0; t < e->vocab.n; t++)
            if (strcmp(e->vocab.text[t], cfg->stop_word) == 0) { stop_id = t; break; }
    }

    double td0 = now_ms();
    long generated = 0;
    while (generated < budget) {
        if (next == e->vocab.eos) break;
        if (stop_id >= 0 && next == stop_id) break;

        ph_detokenize_piece(&e->vocab, next, piece, sizeof piece);
        if (cb(piece, next, user) != 0) { free(ids); return PHONOS_ERR_CANCELLED; }

        PUSH_HIST(next);
        generated++;

        if (cur_len >= e->n_ctx) {
            phonos_log(PHONOS_LOG_WARN, "runtime: context full at %d tokens", cur_len);
            break;
        }

        last_logits = run_step(e, &next, 1, cur_len, 0);
        if (!last_logits) { free(ids); return PHONOS_ERR_GENERIC; }
        cur_len++;

        int tmp2;
        if (ph_sample_next((float*)last_logits, e->hp.n_vocab, &sc, rng,
                           hist, nhist, &tmp2) != PHONOS_OK) { free(ids); return PHONOS_ERR_NOMEM; }
        next = tmp2;
        rng = ph_rng_advance(rng);
    }
    e->ms_decode_total = now_ms() - td0;
    e->n_generated = generated;

    free(ids);
    (void)max_ids;
    return PHONOS_OK;
}

phonos_status engine_transcribe(struct engine* e, const struct audio_view* av,
                                const char* text_prompt,
                                const struct gen_config* cfg,
                                phonos_token_cb cb, void* user) {
    if (!e) return PHONOS_ERR_INVALID_ARG;
    if (!av && !text_prompt) return PHONOS_ERR_INVALID_ARG;
    if (av && !e->hp.has_speech) {
        phonos_log(PHONOS_LOG_ERROR, "runtime: model has no speech encoder");
        return PHONOS_ERR_UNSUPPORTED;
    }
    if (av) {
        phonos_log(PHONOS_LOG_WARN, "runtime: speech path lands in Phase 2 (P2)");
        return PHONOS_ERR_UNSUPPORTED;
    }
    return engine_generate(e, text_prompt, cfg, cb, user);
}

/* ---- introspection --------------------------------------------------------- */
int engine_vocab_size(struct engine* e)   { return e ? e->hp.n_vocab : 0; }
int engine_n_layers(struct engine* e)     { return e ? e->hp.n_layers : 0; }
int engine_n_ctx_train(struct engine* e)  { return e ? e->n_ctx : 0; }
int engine_has_speech(struct engine* e)   { return e ? e->hp.has_speech : 0; }
const char* engine_arch_name(struct engine* e) { (void)e; return PH_ARCH_NAME; }
size_t engine_weight_bytes(struct engine* e){ return e ? e->w.total_bytes : 0; }

void engine_last_perf(struct engine* e, double* ms_prefill, double* ms_per_tok, long* n_tokens) {
    if (ms_prefill)  *ms_prefill  = e ? e->ms_prefill : 0;
    if (ms_per_tok)  *ms_per_tok  = (e && e->n_generated > 0) ? e->ms_decode_total/(double)e->n_generated : 0;
    if (n_tokens)    *n_tokens    = e ? e->n_generated : 0;
}
